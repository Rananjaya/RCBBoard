<?xml version="1.0" encoding="utf-8"?>
<!-- Fret (RCB Classic) key preview balloon: graphite with a thin silver edge, floating above the pressed key.
     Original artwork. SPDX-License-Identifier: GPL-3.0-only -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/rcb_classic_key_pressed_top" android:centerColor="@color/rcb_classic_key_top" android:endColor="@color/rcb_classic_panel" />
    <stroke android:width="1dp" android:color="@color/rcb_classic_panel_border" />
    <corners android:radius="6dp" />
    <size android:width="56dp" android:height="8dp" />
    <padding android:left="8dp" android:top="6dp" android:right="8dp" android:bottom="8dp" />
</shape>
